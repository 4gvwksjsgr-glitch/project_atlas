SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# URL pubblico dell'app (senza trailing slash). Deve coincidere con la porta usata in locale.
# Avvio consigliato: flutter run -d chrome --web-port 8080
# Redirect URLs Supabase (hash routing): http://localhost:8080 e http://localhost:8080/
APP_URL=http://localhost:8080
APP_ENV=development
LOG_LEVEL=debug
